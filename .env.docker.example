# Copy to .env.docker and adjust. Used by docker-compose.yml and Start-ChaosForge.ps1.

# InferRouter base URL as seen from INSIDE the container (required).
# "localhost" would point at the container itself - use host.docker.internal
# for an InferRouter running on the Docker host, or a LAN address.
INFERROUTER_BASE_URL=http://host.docker.internal:5100

# Agent worker poll interval in milliseconds (optional).
POLLING_INTERVAL_MS=3000
